{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "default_locale": "zh_TW",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/taiwan-today.png",
    "48": "icons/taiwan-today.png",
    "128": "icons/taiwan-today.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "search"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.open-meteo.com https://raw.githubusercontent.com; img-src 'self' data: blob:;"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ],
  "optional_host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}
